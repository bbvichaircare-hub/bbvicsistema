# ============================================
# CONFIGURAÇÕES DE NEGÓCIO
# ============================================

# Taxa padrão de imposto (%)
VITE_TAXA_PADRAO=6.25

# Comissão padrão para vendedores (%)
VITE_COMISSAO_PADRAO=10

# Validade padrão de orçamentos (dias)

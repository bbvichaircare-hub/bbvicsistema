rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // FUNÇÕES AUXILIARES DE SEGURANÇA
    // ============================================

    // Verifica se usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se é administrador (role = 'admin')
    function isAdmin() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Verifica se é vendedor (role = 'vendedor')
    function isVendedor() {
      return isAuthenticated() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'vendedor';
    }

    // Verifica se o usuário é dono do recurso (vendedor_id == auth.uid)
    function isOwner() {
      return isAuthenticated() && resource.data.vendedor_id == request.auth.uid;
    }

    // Verifica se está criando recurso como vendedor (vendedor_id == auth.uid)
    function isCreatingAsOwner() {
      return isAuthenticated() && request.resource.data.vendedor_id == request.auth.uid;
    }

    // Verifica se usuário tem acesso total a clientes/faturas/orçamentos
    function isAdminOuAcessoTotal() {
      return isAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ver_todos_clientes == true
      );
    }

    // Verifica se usuário está ativo
    // SEGURANÇA: exige que exista o cadastro em /users. Antes, uma conta criada
    // por qualquer pessoa no Firebase Auth (sem cadastro em /users) era tratada
    // como "ativa". O login do sistema já exige esse cadastro, então nada muda
    // para administradores e vendedores.
    function isUserActive() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ativo in [true, 'true'];
    }

    // Admin ou vendedor cadastrado (equipe interna)
    function isEquipe() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'vendedor'];
    }

    // Valida se campos críticos não foram alterados indevidamente
    function validarCamposCriticosInvoice() {
      // Não permite alterar vendedor_id após criação
      return resource.data.vendedor_id == request.resource.data.vendedor_id;
    }

    function validarCamposCriticosEstimate() {
      // Não permite alterar vendedor_id após criação
      return resource.data.vendedor_id == request.resource.data.vendedor_id;
    }

    // ============================================
    // COLEÇÃO: USERS (USUÁRIOS)
    // ============================================
    match /users/{userId} {
      // Leitura: Admin vê todos, usuário vê apenas o próprio
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);

      // Criação: Apenas admin pode criar usuários
      allow create: if isAdmin() &&
                      request.resource.data.keys().hasAll(['email', 'nome', 'role', 'ativo']) &&
                      request.resource.data.role in ['admin', 'vendedor'];

      // Atualização: Admin pode atualizar qualquer um.
      // SEGURANÇA: o próprio usuário só pode alterar dados de perfil. Antes ele
      // podia mudar comissao_percentual, ver_todos_clientes, permissoes, salário etc.
      allow update: if isAdmin() ||
                      (isAuthenticated() && request.auth.uid == userId &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['nome', 'telefone', 'foto_url', 'avatar_url', 'updated_at', 'last_login']));

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: CLIENTES
    // ============================================
    match /clientes/{clienteId} {
      // Leitura: Admin (ou acesso total) vê todos, vendedor vê apenas os seus
      allow read: if isAdminOuAcessoTotal() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Admin pode criar para qualquer vendedor; vendedor só para si mesmo
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.keys().hasAll(['nome', 'vendedor_id']) &&
                      (isAdmin() || request.resource.data.vendedor_id == request.auth.uid) &&
                      (isAdmin() || request.resource.data.status == 'ativo' || request.resource.data.ativo == true);

      // Atualização: Admin pode tudo, vendedor só os seus e não pode mudar vendedor_id
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid &&
                       request.resource.data.vendedor_id == resource.data.vendedor_id);

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: PRODUTOS
    // ============================================
    match /produtos/{produtoId} {
      // Leitura: Todos autenticados ativos podem ver produtos ativos
      // (ativo true ou não definido). Admin vê todos inclusive inativos.
      allow get: if isUserActive() && isEquipe() &&
                   (resource.data.ativo != false || isAdmin());

      allow list: if isUserActive() && isEquipe();

      // Criação, Atualização, Deleção: Apenas admin
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: INVOICES (FATURAS)
    // ============================================
    match /invoices/{invoiceId} {
      // Leitura: Admin (ou acesso total) vê todas, vendedor vê apenas as suas
      allow read: if isAdminOuAcessoTotal() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Vendedor só pode criar fatura para si mesmo
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.vendedor_id == request.auth.uid &&
                      request.resource.data.keys().hasAll(['numero', 'cliente_id', 'items', 'total', 'vendedor_id', 'status']) &&
                      request.resource.data.status in ['rascunho', 'enviado'];

      // Atualização: Admin pode tudo, vendedor só as suas e não pode mudar vendedor_id
      // Vendedor NÃO pode editar vendas com status 'pago' ou 'cancelado'
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid &&
                       request.resource.data.vendedor_id == resource.data.vendedor_id &&
                       validarCamposCriticosInvoice() &&
                       resource.data.status != 'pago' &&
                       resource.data.status != 'cancelado');

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: ESTIMATES (ORÇAMENTOS)
    // ============================================
    match /estimates/{estimateId} {
      // Leitura: Admin (ou acesso total) vê todos, vendedor vê apenas os seus
      allow read: if isAdminOuAcessoTotal() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Vendedor só pode criar orçamento para si mesmo
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.vendedor_id == request.auth.uid &&
                      request.resource.data.keys().hasAll(['numero', 'cliente_id', 'items', 'total', 'vendedor_id', 'status']) &&
                      request.resource.data.status in ['rascunho', 'enviado'];

      // Atualização: Admin pode tudo, vendedor só os seus e não pode mudar vendedor_id
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid &&
                       request.resource.data.vendedor_id == resource.data.vendedor_id &&
                       validarCamposCriticosEstimate());

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: COMISSOES
    // ============================================
    match /comissoes/{comissaoId} {
      // Leitura: Admin vê todas, vendedor vê apenas as suas
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Apenas admin (sistema gera automaticamente ao dar baixa na fatura)
      allow create: if isAdmin();

      // Atualização: Admin pode tudo, vendedor NÃO pode alterar comissão
      // Vendedor só pode visualizar, nunca editar
      allow update: if isAdmin();

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: RECEITAS
    // ============================================
    match /receitas/{receitaId} {
      // Leitura: Admin vê todas, vendedor vê apenas as suas
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Admin pode criar para qualquer vendedor; vendedor só para si mesmo
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.keys().hasAll(['descricao', 'valor']) &&
                      (isAdmin() || request.resource.data.vendedor_id == request.auth.uid);

      // Atualização/Deleção: Apenas admin
      allow update, delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: NOTIFICACOES
    // ============================================
    match /notificacoes/{notificacaoId} {
      // Leitura: Admin vê todas, vendedor vê apenas as que foram direcionadas a ele
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.usuario_id == request.auth.uid);

      // Criação: Qualquer usuário autenticado ativo pode criar notificações do sistema
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.keys().hasAll(['tipo', 'titulo', 'mensagem']);

      // Atualização/Deleção: Apenas admin
      allow update, delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: CONTAS_RECEBER
    // ============================================
    match /contas_receber/{contaId} {
      // Leitura: Admin vê todas, vendedor vê apenas as suas
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Admin pode criar para qualquer vendedor; vendedor só para si mesmo
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.keys().hasAll(['descricao', 'valor', 'vendedor_id']) &&
                      (isAdmin() || request.resource.data.vendedor_id == request.auth.uid);

      // Atualização: Admin pode tudo; vendedor só pode atualizar as suas e não pode
      // alterar campos críticos
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid &&
                       request.resource.data.vendedor_id == resource.data.vendedor_id);

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: DESPESAS (alias alternativo de expenses)
    // ============================================
    match /despesas/{despesaId} {
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid &&
                       request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: CONFIGURACOES
    // ============================================
    match /configuracoes/{configId} {
      // Leitura: equipe interna (o doc "pagamentos" é público, ver regra abaixo)
      allow read: if isEquipe();

      // Escrita: Apenas admin
      allow create, update, delete: if isAdmin();
    }

    // ============================================
    // COLEÇÕES AUXILIARES COM PADRÃO VENDEDOR
    // ============================================
    // agenda, alertas_estoque, audit_log, campanhas_crm, compras,
    // contas_pagar, estoque_movimentos, faturas_recorrentes, funcionarios,
    // lembretes_enviados, movimentacoes_estoque, pagamentos,
    // pagamentos_comissao, pagamentos_salario, registros_ponto

    match /agenda/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /alertas_estoque/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /audit_log/{docId} {
      // Leitura: Admin vê todas, vendedor vê apenas as suas (se tiver vendedor_id)
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid) ||
                    (isVendedor() && resource.data.usuario_id == request.auth.uid);

      // Criação: Qualquer usuário autenticado ativo pode gerar logs de auditoria
      allow create: if isAuthenticated() && isUserActive();

      // Update/Delete: Apenas admin (logs não devem ser alterados)
      allow update, delete: if isAdmin();
    }

    match /campanhas_crm/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /compras/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /contas_pagar/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /estoque_movimentos/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isUserActive();
      allow update, delete: if isAdmin();
    }

    match /faturas_recorrentes/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /funcionarios/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /lembretes_enviados/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /movimentacoes_estoque/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isUserActive();
      allow update, delete: if isAdmin();
    }

    match /pagamentos/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    match /pagamentos_comissao/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /pagamentos_salario/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /registros_ponto/{docId} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid);
      allow create: if isAuthenticated() && isUserActive() && request.resource.data.vendedor_id == request.auth.uid;
      allow update: if isAdmin() || (isVendedor() && resource.data.vendedor_id == request.auth.uid && request.resource.data.vendedor_id == resource.data.vendedor_id);
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: EXPENSES (DESPESAS)
    // ============================================
    match /expenses/{expenseId} {
      // Leitura: Admin vê todas, vendedor vê apenas as suas
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Vendedor só pode criar despesa para si mesmo
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.vendedor_id == request.auth.uid;

      // Atualização: Admin pode tudo, vendedor só as suas
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid &&
                       request.resource.data.vendedor_id == resource.data.vendedor_id);

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: ESTOQUE_MOVIMENTACAO
    // ============================================
    match /estoque_movimentacao/{movId} {
      // Leitura: Apenas admin (log interno)
      allow read: if isAdmin();

      // Criação, Atualização, Deleção: Apenas via Cloud Function
      allow create, update, delete: if false;
    }

    // ============================================
    // COLEÇÃO: MOVIMENTOS_ESTOQUE (log de baixa/entrada de estoque
    // usado por faturas e consignação)
    // ============================================
    match /movimentos_estoque/{movId} {
      // Leitura: Apenas admin (log interno)
      allow read: if isAdmin();

      // Criação: Qualquer usuário autenticado ativo (vendedor ou admin)
      // pode registrar o movimento ao vender/entregar produto
      allow create: if isAuthenticated() && isUserActive();

      // Atualização/Deleção: Apenas admin
      allow update, delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: QUILOMETRAGEM
    // ============================================
    match /quilometragem/{kmId} {
      // Leitura: Admin vê todas, vendedor vê apenas as suas
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Vendedor só pode criar para si mesmo
      allow create: if isAuthenticated() && isUserActive() &&
                      request.resource.data.vendedor_id == request.auth.uid;

      // Atualização: Admin pode tudo, vendedor só as suas
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid &&
                       request.resource.data.vendedor_id == resource.data.vendedor_id);

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: VISITAS_CRM (VISITAS A SALÕES)
    // ============================================
    match /visitas_crm/{visitaId} {
      // Leitura: Admin vê todas, vendedor vê apenas as suas
      allow read: if isAdmin() ||
                    (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Criação: Qualquer usuário autenticado ativo pode registrar visita
      // (admin pode criar em nome de qualquer vendedor)
      allow create: if isAuthenticated() && isUserActive() &&
                      (isAdmin() || request.resource.data.vendedor_id == request.auth.uid);

      // Atualização: Admin pode tudo, vendedor só as suas
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: CONSIGNACOES (SALDO POR CLIENTE/PRODUTO)
    // Uso exclusivo do administrador
    // ============================================
    match /consignacoes/{consignacaoId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: CONSIGNACAO_MOVIMENTOS (HISTÓRICO)
    // Uso exclusivo do administrador
    // ============================================
    match /consignacao_movimentos/{movimentoId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: AGENDAMENTOS
    // ============================================
    match /agendamentos/{agendamentoId} {
      // Leitura: equipe interna (admin e vendedores)
      allow read: if isEquipe();

      // Criação: Qualquer usuário autenticado pode criar
      allow create: if isAuthenticated() && isUserActive();

      // Atualização: Admin pode tudo, vendedor só os seus
      allow update: if isAdmin() ||
                      (isVendedor() && resource.data.vendedor_id == request.auth.uid);

      // Deleção: Apenas admin
      allow delete: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: CONFIGURACOES
    // ============================================
    match /configuracoes/{configId} {
      // Leitura: Todos autenticados, e o doc "pagamentos" é público
      // (necessário para o cliente ver métodos de pagamento no link da fatura)
      allow read: if isEquipe() || configId == 'pagamentos';

      // Escrita: Apenas admin
      allow write: if isAdmin();
    }

    // ============================================
    // COLEÇÃO: AUDIT_LOGS (LOGS DE AUDITORIA)
    // ============================================
    match /audit_logs/{logId} {
      // Leitura: Apenas admin pode consultar logs
      allow read: if isAdmin();

      // Criação: Apenas via Cloud Function
      allow create: if false;

      // Atualização/Deleção: Ninguém pode alterar logs (imutáveis)
      allow update, delete: if false;
    }

    // ============================================
    // COLEÇÃO: BACKUP_LOGS (LOGS DE BACKUP)
    // ============================================
    match /backup_logs/{logId} {
      // Leitura: Apenas admin
      allow read: if isAdmin();

      // Criação: Apenas via Cloud Function
      allow create: if false;

      // Atualização/Deleção: Ninguém pode alterar
      allow update, delete: if false;
    }

    // ============================================
    // COLEÇÃO: CLIENTES_CONSIGNADO
    // ============================================
    match /clientes_consignado/{clienteId} {
      // Leitura: Admin vê todos, vendedor vê apenas os seus clientes
      allow read: if isAdmin() ||
                    (isVendedor() &&
                     get(/databases/$(database)/documents/clientes/$(clienteId)).data.vendedor_id == request.auth.uid);

      // Criação, Atualização, Deleção: Apenas via Cloud Function
      allow create, update, delete: if false;
    }

    // ============================================
    // COLEÇÃO: CONSIGNADO_PAGAMENTOS
    // ============================================
    match /consignado_pagamentos/{pagamentoId} {
      // Leitura: Admin vê todos, vendedor vê apenas os seus
      allow read: if isAdmin() ||
                    (isVendedor() &&
                     get(/databases/$(database)/documents/clientes/$(resource.data.cliente_id)).data.vendedor_id == request.auth.uid);

      // Criação, Atualização, Deleção: Apenas via Cloud Function
      allow create, update, delete: if false;
    }

    // ============================================
    // ACESSO PÚBLICO VIA TOKEN
    // ============================================
    match /invoices/{invoiceId} {
      // Acesso público via link (para clientes sem login):
      // qualquer fatura que tenha public_token pode ser lida pelo ID direto
      // ou por uma consulta filtrando por public_token (forma como o link é gerado).
      allow get: if resource.data.public_token != null;
      allow list: if resource.data.public_token != null;

      // Permite apenas atualizar os campos de rastreio/pagamento
      // (não permite marcar como "pago" nem alterar valores/itens)
      // SEGURANÇA: o status só pode virar "aguardando_confirmacao" (o que a tela
      // do cliente faz). Antes qualquer pessoa podia mudar para "cancelado" etc.
      // Fatura já paga ou cancelada não muda mais pelo link.
      allow update: if resource.data.public_token != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visualizado', 'visualizado_count', 'visualizado_em',
                    'metodo_pagamento_escolhido', 'metodo_pagamento_em', 'status']) &&
        (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (request.resource.data.status == 'aguardando_confirmacao' &&
           !(resource.data.status in ['pago', 'cancelado'])));
    }

    match /estimates/{estimateId} {
      // Acesso público via link (para clientes sem login):
      // qualquer orçamento que tenha public_token pode ser lido pelo ID direto
      // ou por uma consulta filtrando por public_token (forma como o link é gerado).
      allow get: if resource.data.public_token != null;
      allow list: if resource.data.public_token != null;

      // Permite apenas atualizar campos de rastreio/aprovação (aprovar/recusar)
      allow update: if resource.data.public_token != null &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['visualizado', 'visualizado_count', 'visualizado_em',
                    'status', 'aprovado_em', 'recusado_em', 'invoice_gerada_id']) &&
        (!('status' in request.resource.data.diff(resource.data).affectedKeys()) ||
          request.resource.data.status in ['visualizado', 'aprovado', 'recusado']);
    }

    // Permite gerar a fatura real quando o cliente aprova um orçamento público
    // SEGURANÇA: a fatura precisa copiar total, itens, cliente e vendedor do
    // orçamento, e o orçamento não pode já ter sido aprovado/convertido.
    // Antes qualquer pessoa podia criar faturas com qualquer valor.
    match /invoices/{invoiceId} {
      allow create: if request.resource.data.estimate_origem is string &&
        request.resource.data.estimate_origem != '' &&
        exists(/databases/$(database)/documents/estimates/$(request.resource.data.estimate_origem)) &&
        get(/databases/$(database)/documents/estimates/$(request.resource.data.estimate_origem)).data.public_token != null &&
        !(get(/databases/$(database)/documents/estimates/$(request.resource.data.estimate_origem)).data.get('status', '') in ['aprovado', 'recusado', 'convertido']) &&
        get(/databases/$(database)/documents/estimates/$(request.resource.data.estimate_origem)).data.get('invoice_gerada_id', '') == '' &&
        request.resource.data.total == get(/databases/$(database)/documents/estimates/$(request.resource.data.estimate_origem)).data.get('total', 0) &&
        request.resource.data.items == get(/databases/$(database)/documents/estimates/$(request.resource.data.estimate_origem)).data.get('items', []) &&
        request.resource.data.cliente_id == get(/databases/$(database)/documents/estimates/$(request.resource.data.estimate_origem)).data.get('cliente_id', '') &&
        request.resource.data.vendedor_id == get(/databases/$(database)/documents/estimates/$(request.resource.data.estimate_origem)).data.get('vendedor_id', '') &&
        request.resource.data.keys().hasAll(['numero', 'cliente_id', 'items', 'total', 'status']) &&
        request.resource.data.status == 'enviado';
    }

    // ============================================
    // PORTAL DO CLIENTE (acesso sem login, por email)
    // ============================================

    // Login: localizar o cliente pelo email cadastrado
    match /clientes/{clienteId} {
      allow list: if resource.data.email is string && resource.data.email != '';
      allow get: if resource.data.email is string && resource.data.email != '';
    }

    // Listagem de faturas/orçamentos do próprio cliente no portal
    match /invoices/{invoiceId} {
      allow list: if resource.data.cliente_email is string && resource.data.cliente_email != '';
    }
    match /estimates/{estimateId} {
      allow list: if resource.data.cliente_email is string && resource.data.cliente_email != '';
    }

    // Consignação: cliente pode apenas visualizar seu próprio saldo (sem editar)
    match /consignacoes/{consignacaoId} {
      allow list, get: if resource.data.cliente_id is string && resource.data.cliente_id != '';
    }
  }
}

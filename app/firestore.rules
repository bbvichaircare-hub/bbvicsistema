rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // === REGRAS PARA USUARIOS AUTENTICADOS ===
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // === ACESSO PUBLICO CONTROLADO ===

    // Configuracoes - leitura publica
    match /configuracoes/{docId} {
      allow read: if true;
    }

    // Orcamentos - leitura publica + update para aprovacao/recusa pelo cliente
    match /estimates/{estimateId} {
      allow read: if true;
      allow update: if request.auth != null ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'aprovado_em', 'visualizado_em', 'cliente_assinou',
                    'invoice_gerada_id', 'recusado_em']));
    }

    // Faturas - leitura publica + criacao publica (aprovacao de orcamento pelo cliente)
    match /invoices/{invoiceId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.auth != null ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'visualizado_em', 'cliente_confirmou', 'pago_em',
                    'visualizado', 'visualizado_count', 'metodo_pagamento_escolhido',
                    'metodo_pagamento_em', 'aprovado_em']));
    }

    // Notificacoes - criacao publica
    match /notificacoes/{notifId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Contas a receber - criacao publica (aprovacao de orcamento pelo cliente)
    match /contas_receber/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Clientes
    match /clientes/{docId} {
      allow read, write: if request.auth != null;
    }

    // Produtos / Estoque
    match /produtos/{docId} {
      allow read, write: if request.auth != null;
    }

    // Vendedores
    match /vendedores/{docId} {
      allow read, write: if request.auth != null;
    }

    // Despesas
    match /despesas/{docId} {
      allow read, write: if request.auth != null;
    }

    // Compras
    match /compras/{docId} {
      allow read, write: if request.auth != null;
    }

    // Caixa
    match /caixa/{docId} {
      allow read, write: if request.auth != null;
    }

    // Contas a pagar
    match /contas_pagar/{docId} {
      allow read, write: if request.auth != null;
    }

    // Agenda
    match /agenda/{docId} {
      allow read, write: if request.auth != null;
    }

    // Projetos
    match /projetos/{docId} {
      allow read, write: if request.auth != null;
    }

    // Quilometragem
    match /quilometragem/{docId} {
      allow read, write: if request.auth != null;
    }

    // Comissoes
    match /comissoes/{docId} {
      allow read, write: if request.auth != null;
    }

    // Logs de auditoria
    match /audit_logs/{docId} {
      allow read, write: if request.auth != null;
    }

    // Usuarios do sistema
    match /usuarios/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
